# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public Landing Page Chatbot Gemini AI Fallback (server-side only)
# Set CHATBOT_AI_ENABLED="true" and provide GEMINI_API_KEY in .env to enable AI fallback.
CHATBOT_AI_ENABLED="false"
CHATBOT_AI_DAILY_CAP="200"

# APP_BASE_URL: Base URL used to build QR code ordering links ({APP_BASE_URL}/franchisee/order).
APP_BASE_URL="https://ais-dev-lnqv3lnandefmc6k65orpf-15288705897.asia-east1.run.app"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Production UI & Seeding Flags (default to "false" in production)
SHOW_TEST_ACCOUNTS="false"
SEED_DEMO_DATA="false"

# Default Admin account initial password (must be changed at first login)
ADMIN_INITIAL_PASSWORD="Admin@1234"

# JWT signing secret (set a strong random secret in production)
JWT_SECRET="change_this_to_a_strong_random_secret"

# Cloud SQL PostgreSQL connection details (automatically injected in AI Studio;
# on Cloud Run attach the Cloud SQL instance pro-philosophy-zbpf3:asia-southeast1:ai-studio-97325ae7
# and point SQL_HOST to the Unix socket directory, e.g. /cloudsql/pro-philosophy-zbpf3:asia-southeast1:ai-studio-97325ae7)
SQL_HOST="/cloudsql/pro-philosophy-zbpf3:asia-southeast1:ai-studio-97325ae7"
SQL_DB_NAME="cloud_sql_development_database"
SQL_USER="ai_studio_app_user"
SQL_PASSWORD="YOUR_CLOUD_SQL_APP_PASSWORD"

# Cloud SQL Admin credentials (used ONLY by Drizzle Kit schema push, never at runtime)
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="YOUR_CLOUD_SQL_ADMIN_PASSWORD"
